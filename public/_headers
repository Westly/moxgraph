/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self' https://moxgraph-import-relay-probe.westlywhite.workers.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/data/:version/*
  Cache-Control: public, max-age=31536000, immutable

/data/active.json
  Cache-Control: no-cache
