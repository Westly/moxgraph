        "imageUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[hH][tT][tT][pP][sS]?://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index",
        "name",
        "oracleId",
        "sourceArtistCredit",
        "artistIds",
        "illustrationId",
        "imageUrl"
      ]
    },
